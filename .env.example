# Copy to .env.docker (Docker) or export in your shell (local run). Never commit real values.
# Secret key for Flask sessions; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY=change-me
# Password of the PostgreSQL user "blog" (compose only).
POSTGRES_PASSWORD=change-me-too
# Optional: host port of the web service (compose only).
WEB_PORT=8000
# Optional: database URI for a local run; default is sqlite:///posts.db.
# DB_URI=postgresql://user:password@host:5432/dbname
# Optional: contact form sender.
# MAIL_USER=
# MAIL_PASSWORD=
